#!/bin/bash
#PBS -N flatfold
#PBS -q COLA
#PBS -l select=1:ncpus=1:mem=32gb
#PBS -l walltime=04:00:00
#PBS -J 1-2250
#PBS -o experiments/logs/
#PBS -e experiments/logs/
#PBS -j oe

cd $PBS_O_WORKDIR
module load python/3.12.8 gurobi/12.0.3

LINEA=$(sed -n "${PBS_ARRAY_INDEX}p" ${JOBS:-experiments/jobs.txt})
python3 -O experiments/run_experimentos.py $LINEA